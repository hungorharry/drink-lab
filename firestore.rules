rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: rooms
    // Document ID: {roomCode} (string, 1-32 characters, e.g. "SIP-ABCD", "ALCH88")
    //
    // Fields:
    //   - code: string (required, 1-32 chars, immutable, matches document ID)
    //   - status: string (required, allowed: 'lobby' | 'playing' | 'summary')
    //   - players: list of maps (required, 1-50 player entries)
    //   - hostEmail: string (optional, up to 100 chars)
    //   - hostName: string (optional, up to 100 chars)
    //   - totalCards: int/number (optional, 0 to 1000)
    //   - deck: list of maps (optional, up to 1000 card items)
    //   - currentCardIndex: int/number (optional, 0 to 1000)
    //   - currentTurnIdx: int/number (optional, 0 to 100)
    //   - isFlipped: bool (optional)
    //   - beerConsumed: number (optional, >= 0 and <= 100000)
    //   - history: list of maps (optional, up to 1000 history items)
    //   - reactions: list of maps (optional, up to 200 items)
    //   - updatedAt: number or timestamp (optional)
    //
    // Realtime Gameplay Aliases (supported for multiplayer integration sync):
    //   - currentTurnIndex: int/number (optional, 0 to 100)
    //   - isFlipping: bool (optional)
    //   - currentCard: map (optional, currently revealed card object)
    //   - drawnAt: number or timestamp (optional)
    //   - round: int/number (optional, 0 to 1000)
    //   - votes: map (optional, player votes map, size <= 100)
    //   - endGameRequest: map (optional, all-player consensus request)
    //
    // ---------------------------------------------------------------
    //
    // Collection: online_users
    // Document ID: {uid} (string, 1-128 characters, matching user ID)
    //
    // Fields:
    //   - uid: string (required, 1-128 chars, matches document ID, immutable)
    //   - name: string (optional, up to 100 chars)
    //   - email: string (optional, up to 100 chars)
    //   - avatar: string (optional, up to 500 chars)
    //   - lastActive: number or timestamp (optional, presence heartbeat)
    //   - currentRoomCode: string (optional, up to 32 chars)
    //   - incomingInvite: map or null (optional, size <= 10)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validate room code path format (string, 1-32 characters)
    function isValidRoomCode(roomCode) {
      return roomCode is string &&
             roomCode.size() > 0 &&
             roomCode.size() <= 32;
    }

    // Check if the required fields exist in the incoming document
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Check that no arbitrary or unexpected fields are added (Strict Schema)
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Check if the user is the authenticated room host
    function isRoomHost() {
      return isAuthenticated() && (
        (('hostEmail' in resource.data) &&
         resource.data.hostEmail is string &&
         resource.data.hostEmail != '' &&
         request.auth.token.email == resource.data.hostEmail) ||
        (('players' in resource.data) &&
         resource.data.players is list &&
         resource.data.players.size() > 0 &&
         resource.data.players[0] is map &&
         ('uid' in resource.data.players[0]) &&
         resource.data.players[0].uid == request.auth.uid)
      );
    }

    // ===============================================================
    // Domain Validator: Online User Presence
    // ===============================================================

    function isValidOnlineUser(data, uid) {
      return hasRequiredFields(data, ['uid']) &&
        hasOnlyAllowedFields(data, [
          'uid',
          'name',
          'email',
          'avatar',
          'lastActive',
          'currentRoomCode',
          'incomingInvite'
        ]) &&
        data.uid is string &&
        data.uid == uid &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 100)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100)) &&
        (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 500)) &&
        (!('lastActive' in data) || data.lastActive == null || data.lastActive is number || data.lastActive is timestamp) &&
        (!('currentRoomCode' in data) || data.currentRoomCode == null || (data.currentRoomCode is string && data.currentRoomCode.size() <= 32)) &&
        (!('incomingInvite' in data) || data.incomingInvite == null || (data.incomingInvite is map && data.incomingInvite.size() <= 10));
    }

    // ===============================================================
    // Domain Validator: Room State
    // ===============================================================

    function isValidRoom(data, roomCode) {
      return hasRequiredFields(data, ['code', 'status', 'players']) &&
        hasOnlyAllowedFields(data, [
          'code',
          'status',
          'players',
          'hostEmail',
          'hostName',
          'totalCards',
          'deck',
          'currentCardIndex',
          'currentTurnIdx',
          'isFlipped',
          'beerConsumed',
          'history',
          'reactions',
          'updatedAt',
          'currentTurnIndex',
          'isFlipping',
          'currentCard',
          'drawnAt',
          'round',
          'votes',
          'endGameRequest'
        ]) &&
        // Required field validation
        data.code is string &&
        data.code == roomCode &&
        data.code.size() <= 32 &&
        data.status is string &&
        data.status in ['lobby', 'playing', 'summary'] &&
        data.players is list &&
        data.players.size() >= 1 &&
        data.players.size() <= 50 &&

        // Optional field validation with strict types & size bounds (DoS/resource exhaustion prevention)
        (!('hostEmail' in data) || (data.hostEmail is string && data.hostEmail.size() <= 100)) &&
        (!('hostName' in data) || (data.hostName is string && data.hostName.size() <= 100)) &&
        (!('totalCards' in data) || (data.totalCards is number && data.totalCards >= 0 && data.totalCards <= 1000)) &&
        (!('deck' in data) || (data.deck is list && data.deck.size() <= 1000)) &&
        (!('currentCardIndex' in data) || (data.currentCardIndex is number && data.currentCardIndex >= 0 && data.currentCardIndex <= 1000)) &&
        (!('currentTurnIdx' in data) || (data.currentTurnIdx is number && data.currentTurnIdx >= 0 && data.currentTurnIdx <= 100)) &&
        (!('isFlipped' in data) || (data.isFlipped is bool)) &&
        (!('beerConsumed' in data) || (data.beerConsumed is number && data.beerConsumed >= 0 && data.beerConsumed <= 100000)) &&
        (!('history' in data) || (data.history is list && data.history.size() <= 1000)) &&
        (!('reactions' in data) || (data.reactions is list && data.reactions.size() <= 200)) &&
        (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is timestamp)) &&
        (!('currentTurnIndex' in data) || (data.currentTurnIndex is number && data.currentTurnIndex >= 0 && data.currentTurnIndex <= 100)) &&
        (!('isFlipping' in data) || (data.isFlipping is bool)) &&
        (!('currentCard' in data) || (data.currentCard is map)) &&
        (!('drawnAt' in data) || (data.drawnAt is number || data.drawnAt is timestamp)) &&
        (!('round' in data) || (data.round is number && data.round >= 0 && data.round <= 1000)) &&
        (!('votes' in data) || (data.votes is map && data.votes.size() <= 100)) &&
        (!('endGameRequest' in data) || (data.endGameRequest is map));
    }

    // ===============================================================
    // Rules: Rooms Collection
    // ===============================================================

    match /rooms/{roomCode} {
      // Allow read (both get and list) for guests and authenticated players
      // so players can discover and list active public rooms on the lobby screen
      allow read: if true;

      // Allow room creation with schema and data validation
      allow create: if isValidRoomCode(roomCode) &&
                       isValidRoom(request.resource.data, roomCode);

      // Allow room state updates with validation and immutable code preservation
      allow update: if isValidRoomCode(roomCode) &&
                       isValidRoom(request.resource.data, roomCode) &&
                       request.resource.data.code == resource.data.code;

      // Allow room deletion by the host or if inactive for > 5 minutes (300,000 ms)
      allow delete: if isRoomHost() || (
        ('updatedAt' in resource.data) &&
        (resource.data.updatedAt is number) &&
        (request.time.toMillis() - resource.data.updatedAt > 300000)
      );
    }

    // ===============================================================
    // Rules: Online Users Collection
    // ===============================================================

    match /online_users/{uid} {
      // Allow read for all users (to discover online players and invite them)
      allow read: if true;

      // Allow create and update if document data has valid fields
      allow create: if isValidOnlineUser(request.resource.data, uid);

      allow update: if isValidOnlineUser(request.resource.data, uid) &&
                       request.resource.data.uid == resource.data.uid;

      // Allow delete if authenticated user owns the document
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // ===============================================================
    // Default Deny Rule for All Other Collections
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
